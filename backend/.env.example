APP_NAME=Vivi
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/vivi
SESSION_SECRET=replace-with-at-least-32-random-characters
SECURE_COOKIES=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_ORIGINS=["http://localhost:3000"]
EMAIL_MODE=development
DEVELOPMENT_OUTBOX_DIR=./.development-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SESSION_DAYS=14
RATE_LIMIT_WINDOW_SECONDS=900
